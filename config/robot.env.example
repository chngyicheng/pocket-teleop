# Robot identity and footprint — operator-configurable via web settings page.
# Copy to config/robot.env and modify as needed.
# Changes via web settings write directly to config/robot.env (no server restart required).
# Secrets must NOT be stored in this file; see .env for SESSION_SECRET and credentials.

# Robot type: one of diff_drive, holonomic
ROBOT_TYPE=diff_drive

# Robot name (display label in UI)
ROBOT_NAME=

# ROS2 namespace (if the robot runs under a namespace, e.g., /robot1)
ROBOT_NAMESPACE=

# Robot footprint dimensions (meters; bumper-to-bumper length, wheel-to-wheel width).
# Used by the minimap to draw the robot outline.
# If unset (default 0.0), the outline is not displayed.
ROBOT_LENGTH_M=

ROBOT_WIDTH_M=

# Video source — ROS2 topic name for camera stream.
# Common TurtleBot topics:
#   TurtleBot3 (Pi Camera):   /raspicam_node/image/compressed
#   TurtleBot4 (OAK-D):       /oakd/rgb/preview/image_raw/compressed
# Leave empty to disable video streaming.
VIDEO_TOPIC=

# Video topic message type: one of compressed (default) or raw (sensor_msgs/Image).
# Use 'raw' only if your camera publishes an uncompressed sensor_msgs/Image topic.
VIDEO_TOPIC_TYPE=compressed
