<?xml version="1.0" encoding="UTF-8"?>
<!--
  FastDDS profile for observer machines (machines that are NOT running the teleop stack
  but want to inspect ROS2 topics — e.g. `ros2 topic list` or `ros2 topic echo`).

  Required when multicast is broken on your network (common with VMs, certain Wi-Fi
  configurations, and some Linux kernels — symptom: `ros2 multicast receive` fails
  with "No such device").

  This profile disables multicast transport entirely and uses unicast-only discovery,
  with an explicit initial peer pointing at the robot host.

  Both environment variables must be set before launching any ROS2 command:

    export TELEOP_HOST_IP=<robot-LAN-IP>        # e.g. 192.168.10.22
    export ROS_NETWORK_INTERFACE=<your-LAN-IP>  # e.g. 192.168.10.123
    export FASTRTPS_DEFAULT_PROFILES_FILE=/path/to/server/fastrtps_profiles_observer.xml
    ros2 topic list

  ROS_DOMAIN_ID must also match the robot's domain (default: 0):
    export ROS_DOMAIN_ID=0
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_unicast</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>$ENV{ROS_NETWORK_INTERFACE}</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default_profile" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_unicast</transport_id>
      </userTransports>
      <!-- Must be false — builtin transports include multicast, which aborts
           FastDDS transport initialisation on machines with no multicast device. -->
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <!-- Unicast discovery: send SPDP packets directly to the robot host.
               FastDDS will try the standard discovery port range on this address. -->
          <locator>
            <udpv4>
              <address>$ENV{TELEOP_HOST_IP}</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
