# Copy to .env and fill in all values before starting the server.
# NEVER commit .env — it is gitignored.

# Server auth credentials (no defaults — must be set explicitly)
TELEOP_ADMIN_USER=
TELEOP_ADMIN_PASSWORD=

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# ROS2 network settings (optional)
# ROS_DOMAIN_ID must match on all machines that need to see each other (default: 0)
ROS_DOMAIN_ID=0
# IP address of the network interface for ROS2 DDS discovery.
# Must be an IP address, NOT an interface name — FastDDS 2.6.x (ROS2 Humble) does not
# accept interface names like eth0 in interfaceWhiteList; use the IP instead.
# Run `ip addr show eth0` (or wlan0 for Wi-Fi) and copy the inet address.
# Example (wired):   ROS_NETWORK_INTERFACE=192.168.1.50
# Example (Wi-Fi):   ROS_NETWORK_INTERFACE=192.168.1.51
ROS_NETWORK_INTERFACE=192.168.1.50

# WebSocket proxy target — URL of the teleop-server as seen from inside the auth-server container.
# Normally leave this unset: auth-server auto-detects the Docker bridge gateway at startup
# and uses http://<gateway>:9091, which is always reachable regardless of Docker version.
# Override only if the auto-detected gateway is wrong (rare):
#   TELEOP_SERVER_URL=http://192.168.1.50:9091
TELEOP_SERVER_URL=

# Robot identity, footprint, and video source — now in config/robot.env
# These keys have been moved to support runtime configuration via web settings page:
#   ROBOT_TYPE, ROBOT_NAME, ROBOT_NAMESPACE, ROBOT_LENGTH_M, ROBOT_WIDTH_M
#   VIDEO_TOPIC, VIDEO_TOPIC_TYPE
# To migrate an existing deployment: copy config/robot.env.example to config/robot.env,
# then transfer the values of these 7 keys from your current .env into config/robot.env.
# Secrets (credentials, SESSION_SECRET, etc.) remain in .env only.

# Minimap topics (optional — defaults shown below)
# To find your odometry topic: ros2 topic list | grep -i odom
# To find your occupancy grid topic: ros2 topic list | grep -i map
# To find your lidar topic: ros2 topic list | grep -i scan
ODOM_TOPIC=/odom
MAP_TOPIC=/map
MAP_WINDOW_M=24.0

# Pose and scan streaming (optional — for minimap nav + collision avoidance)
# Lidar/scanner topic for decimated scan broadcast
# To find your scan topic: ros2 topic list | grep -i scan
SCAN_TOPIC=/scan
# TF2 frame IDs (defaults shown — must exist in your robot's TF tree)
# View your frame tree: ros2 run tf2_tools view_frames
MAP_FRAME=map
ODOM_FRAME=odom
BASE_FRAME=base_link

# Disconnect-after behavior (optional — SAFETY). What the robot does when the
# operator's connection drops and the watchdog fires:
#   stop        — publish zero cmd_vel and close (default, fail-stop)
#   hold        — keep republishing the last twist for DISCONNECT_ACTION_PARAM ms, then stop
#   continue    — same as hold
#   return_home — auto-trigger DISABLED for now: logs and behaves as stop
#                 (RETURN_HOME_SERVICE client wired; re-enable in teleop_node.cpp)
# WARNING: hold/continue violate the fail-stop principle — a lost link keeps the
# robot moving. Use only where an abrupt stop is itself unsafe.
DISCONNECT_ACTION=stop
DISCONNECT_ACTION_PARAM=0
RETURN_HOME_SERVICE=/return_home

# TLS/HTTPS configuration (optional — only used when starting with --profile tls)
# TLS_DOMAIN: Required when using the tls profile. Set to your robot's public domain name
# or LAN IP address. Example: robot.example.com or 192.168.1.100
TLS_DOMAIN=

# TLS_ACME_EMAIL: Optional. When set, Caddy uses Let's Encrypt ACME to obtain a real certificate.
# Requires: TLS_DOMAIN must be a public domain, and ports 80/443 must be reachable from the internet.
# When empty or unset, Caddy uses its internal CA for self-signed certificates.
# Self-signed certificates work from any network but require trusting the root CA on client devices.
TLS_ACME_EMAIL=

# BIND_HOST: Auth-server binding address. When using tls profile, set this to 127.0.0.1
# to restrict port 8080 to loopback only (Caddy proxies from host network).
# When not using tls profile or for direct access, leave empty (defaults to 0.0.0.0).
BIND_HOST=
