# Copy to .env and fill in all values before starting the server.
# NEVER commit .env — it is gitignored.

# Server auth credentials (no defaults — must be set explicitly)
TELEOP_ADMIN_USER=
TELEOP_ADMIN_PASSWORD=

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional robot identity
ROBOT_TYPE=diff_drive
ROBOT_NAME=
ROBOT_NAMESPACE=

# ROS2 network settings (optional)
# ROS_DOMAIN_ID must match on all machines that need to see each other (default: 0)
ROS_DOMAIN_ID=0
# IP address of the network interface for ROS2 DDS discovery.
# Must be an IP address, NOT an interface name — FastDDS 2.6.x (ROS2 Humble) does not
# accept interface names like eth0 in interfaceWhiteList; use the IP instead.
# Run `ip addr show eth0` (or wlan0 for Wi-Fi) and copy the inet address.
# Example (wired):   ROS_NETWORK_INTERFACE=192.168.1.50
# Example (Wi-Fi):   ROS_NETWORK_INTERFACE=192.168.1.51
ROS_NETWORK_INTERFACE=192.168.1.50

# WebSocket proxy target — URL of the teleop-server as seen from inside the auth-server container.
# Normally leave this unset: auth-server auto-detects the Docker bridge gateway at startup
# and uses http://<gateway>:9091, which is always reachable regardless of Docker version.
# Override only if the auto-detected gateway is wrong (rare):
#   TELEOP_SERVER_URL=http://192.168.1.50:9091
TELEOP_SERVER_URL=
